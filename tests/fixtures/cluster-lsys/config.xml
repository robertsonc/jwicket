<!-- SYNTHETIC. Root, one logical system and one tenant system; not captured from a device. -->
<configuration xmlns:junos="http://xml.juniper.net/junos/24.4R2/junos">
  <security>
    <zones>
      <security-zone>
        <name>inside</name>
        <interfaces><name>reth1.0</name></interfaces>
      </security-zone>
      <security-zone>
        <name>outside</name>
        <interfaces><name>reth0.0</name></interfaces>
      </security-zone>
    </zones>
    <policies>
      <policy>
        <from-zone-name>inside</from-zone-name>
        <to-zone-name>outside</to-zone-name>
        <policy junos:group="node0">
          <name>node0-mgmt-out</name>
          <match>
            <source-address>any</source-address>
            <destination-address>any</destination-address>
            <application>junos-ntp</application>
          </match>
          <then><permit/></then>
        </policy>
        <policy>
          <name>inside-out</name>
          <match>
            <source-address>any</source-address>
            <destination-address>any</destination-address>
            <application>any</application>
          </match>
          <then><permit/></then>
        </policy>
      </policy>
      <default-policy><deny-all/></default-policy>
    </policies>
  </security>
  <logical-systems>
    <name>LS-A</name>
    <security>
      <address-book>
        <name>global</name>
        <address><name>lsys-a-net</name><ip-prefix>172.16.10.0/24</ip-prefix></address>
      </address-book>
      <zones>
        <security-zone><name>a-trust</name><interfaces><name>lt-0/0/0.1</name></interfaces></security-zone>
        <security-zone><name>a-untrust</name><interfaces><name>lt-0/0/0.3</name></interfaces></security-zone>
      </zones>
      <policies>
        <policy>
          <from-zone-name>a-trust</from-zone-name>
          <to-zone-name>a-untrust</to-zone-name>
          <policy>
            <name>a-out</name>
            <match>
              <source-address>lsys-a-net</source-address>
              <destination-address>any</destination-address>
              <application>junos-https</application>
            </match>
            <then><permit/></then>
          </policy>
        </policy>
      </policies>
    </security>
  </logical-systems>
  <tenants inactive="inactive">
    <name>T-1</name>
    <security>
      <zones>
        <security-zone><name>t-in</name></security-zone>
        <security-zone><name>t-out</name></security-zone>
      </zones>
      <policies>
        <policy>
          <from-zone-name>t-in</from-zone-name>
          <to-zone-name>t-out</to-zone-name>
          <policy>
            <name>t-out-web</name>
            <match>
              <source-address>any</source-address>
              <destination-address>any</destination-address>
              <application>junos-http</application>
            </match>
            <then><reject/></then>
          </policy>
        </policy>
      </policies>
    </security>
  </tenants>
</configuration>
