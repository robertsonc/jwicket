<!-- SYNTHETIC. Shaped like <get-configuration database="committed" inherit="inherit" groups="groups">
     on Junos 24.4; not captured from a device. See tests/fixtures/README.md. -->
<configuration xmlns:junos="http://xml.juniper.net/junos/24.4R2/junos" junos:commit-seconds="1795500000" junos:commit-localtime="2026-11-23 04:00:00 UTC" junos:commit-user="admin">
  <system>
    <syslog>
      <file>
        <name>messages</name>
        <contents><name>any</name><notice/></contents>
        <contents><name>authorization</name><info/></contents>
      </file>
      <file>
        <name>interactive-commands</name>
        <contents><name>interactive-commands</name><any/></contents>
      </file>
      <file>
        <name>traffic-log</name>
        <contents><name>any</name><any/></contents>
        <match>RT_FLOW_SESSION</match>
        <structured-data/>
      </file>
    </syslog>
    <services>
      <outbound-ssh>
        <client>
          <name>central-mgr</name>
          <device-id>FIXTURE-DEVICE-ID</device-id>
          <secret>$9$FIXTURE-PLACEHOLDER-NOT-A-SECRET</secret>
          <services><netconf/></services>
          <servers>
            <name>192.0.2.10</name>
            <port>7804</port>
          </servers>
        </client>
      </outbound-ssh>
    </services>
  </system>
  <security>
    <log>
      <mode>event</mode>
    </log>
    <address-book>
      <name>global</name>
      <address junos:group="corp-baseline">
        <name>corp-lan</name>
        <ip-prefix>10.10.0.0/16</ip-prefix>
      </address>
      <address>
        <name>web1</name>
        <ip-prefix>10.20.0.10/32</ip-prefix>
      </address>
      <address>
        <name>web2</name>
        <ip-prefix>10.20.0.11/32</ip-prefix>
      </address>
      <address>
        <name>mail</name>
        <description>Inbound mail relay</description>
        <ip-prefix>10.20.0.25/32</ip-prefix>
      </address>
      <address>
        <name>partner-portal</name>
        <dns-name><name>portal.partner.example</name></dns-name>
      </address>
      <address>
        <name>branch-printers</name>
        <range-address>
          <name>10.10.40.10</name>
          <to><range-high>10.10.40.19</range-high></to>
        </range-address>
      </address>
      <address>
        <name>bad-host-1</name>
        <ip-prefix>198.51.100.66/32</ip-prefix>
      </address>
      <address>
        <name>bad-host-2</name>
        <ip-prefix>203.0.113.99/32</ip-prefix>
      </address>
      <address-set>
        <name>web-servers</name>
        <address><name>web1</name></address>
        <address><name>web2</name></address>
      </address-set>
      <address-set>
        <name>dmz-all</name>
        <address><name>mail</name></address>
        <address-set><name>web-servers</name></address-set>
      </address-set>
      <address-set>
        <name>blocklist</name>
        <address><name>bad-host-1</name></address>
        <address><name>bad-host-2</name></address>
      </address-set>
    </address-book>
    <address-book>
      <name>dmz-book</name>
      <address>
        <name>dmz-jump</name>
        <ip-prefix>10.20.0.50/32</ip-prefix>
      </address>
      <attach>
        <zone><name>dmz</name></zone>
      </attach>
    </address-book>
    <zones>
      <security-zone>
        <name>trust</name>
        <host-inbound-traffic>
          <system-services><name>ssh</name></system-services>
          <system-services><name>ping</name></system-services>
          <system-services><name>https</name></system-services>
        </host-inbound-traffic>
        <interfaces>
          <name>ge-0/0/1.0</name>
        </interfaces>
      </security-zone>
      <security-zone>
        <name>untrust</name>
        <screen>untrust-screen</screen>
        <interfaces>
          <name>ge-0/0/0.0</name>
          <host-inbound-traffic>
            <system-services><name>ike</name></system-services>
            <system-services><name>dhcp</name></system-services>
          </host-inbound-traffic>
        </interfaces>
      </security-zone>
      <security-zone>
        <name>dmz</name>
        <interfaces>
          <name>ge-0/0/2.0</name>
        </interfaces>
      </security-zone>
    </zones>
    <policies>
      <policy>
        <from-zone-name>trust</from-zone-name>
        <to-zone-name>untrust</to-zone-name>
        <policy junos:group="corp-baseline">
          <name>baseline-dns</name>
          <description>Inherited from the corporate baseline group</description>
          <match>
            <source-address>corp-lan</source-address>
            <destination-address>any</destination-address>
            <application>junos-dns-udp</application>
          </match>
          <then>
            <permit/>
          </then>
        </policy>
        <policy>
          <name>allow-web</name>
          <match>
            <source-address>corp-lan</source-address>
            <destination-address>any</destination-address>
            <application>web-apps</application>
          </match>
          <then>
            <permit/>
            <log><session-close/></log>
            <count/>
          </then>
        </policy>
        <policy inactive="inactive">
          <name>block-telnet</name>
          <match>
            <source-address>any</source-address>
            <destination-address>any</destination-address>
            <application>junos-telnet</application>
          </match>
          <then>
            <deny/>
          </then>
        </policy>
      </policy>
      <policy>
        <from-zone-name>trust</from-zone-name>
        <to-zone-name>dmz</to-zone-name>
        <policy>
          <name>admin-to-dmz</name>
          <match>
            <source-address>corp-lan</source-address>
            <destination-address>dmz-all</destination-address>
            <destination-address>dmz-jump</destination-address>
            <application>junos-ssh</application>
            <application>junos-https</application>
          </match>
          <then>
            <permit/>
            <log><session-init/><session-close/></log>
          </then>
        </policy>
      </policy>
      <policy>
        <from-zone-name>untrust</from-zone-name>
        <to-zone-name>dmz</to-zone-name>
        <policy>
          <name>publish-web</name>
          <match>
            <source-address>any</source-address>
            <destination-address>web-servers</destination-address>
            <application>web-apps</application>
          </match>
          <then>
            <permit>
              <application-services>
                <idp-policy>recommended</idp-policy>
              </application-services>
            </permit>
            <log><session-close/></log>
          </then>
        </policy>
        <policy>
          <name>publish-mail</name>
          <match>
            <source-address>any</source-address>
            <destination-address>mail</destination-address>
            <application>junos-smtp</application>
          </match>
          <then>
            <permit/>
          </then>
          <scheduler-name>business-hours</scheduler-name>
        </policy>
      </policy>
      <policy>
        <from-zone-name>untrust</from-zone-name>
        <to-zone-name>trust</to-zone-name>
        <policy>
          <name>deny-inbound</name>
          <match>
            <source-address>any</source-address>
            <destination-address>any</destination-address>
            <application>any</application>
          </match>
          <then>
            <deny/>
            <log><session-init/></log>
          </then>
        </policy>
      </policy>
      <policy>
        <from-zone-name>dmz</from-zone-name>
        <to-zone-name>untrust</to-zone-name>
        <policy>
          <name>dmz-updates</name>
          <match>
            <source-address>web-servers</source-address>
            <destination-address>partner-portal</destination-address>
            <application>junos-https</application>
          </match>
          <then>
            <permit>
              <firewall-authentication>
                <pass-through/>
              </firewall-authentication>
            </permit>
          </then>
        </policy>
      </policy>
      <global>
        <policy>
          <name>global-blocklist</name>
          <match>
            <source-address>blocklist</source-address>
            <destination-address>any</destination-address>
            <application>any</application>
          </match>
          <then>
            <deny/>
            <log><session-init/></log>
          </then>
        </policy>
        <policy junos:group="corp-baseline">
          <name>global-printers</name>
          <match>
            <source-address>branch-printers</source-address>
            <destination-address>any</destination-address>
            <application>junos-ipp</application>
            <from-zone>trust</from-zone>
            <to-zone>dmz</to-zone>
          </match>
          <then>
            <permit/>
          </then>
        </policy>
      </global>
      <default-policy>
        <deny-all/>
      </default-policy>
    </policies>
  </security>
  <applications>
    <application>
      <name>tcp-8443</name>
      <protocol>tcp</protocol>
      <destination-port>8443</destination-port>
    </application>
    <application-set>
      <name>web-apps</name>
      <application><name>junos-http</name></application>
      <application><name>junos-https</name></application>
      <application><name>tcp-8443</name></application>
    </application-set>
  </applications>
</configuration>
