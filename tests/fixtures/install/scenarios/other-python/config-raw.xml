    <system>
      <scripts>
        <language>python3</language>
        <op>
          <file>
            <name>tools.py</name>
          </file>
        </op>
      </scripts>
      <services>
        <netconf>
          <ssh/>
        </netconf>
      </services>
    </system>
    <!-- Event scripts are configured under event-options event-script (junos-es-conf-event-options 23.2R1). -->
